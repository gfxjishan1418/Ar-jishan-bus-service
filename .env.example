# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://placeholder-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# App Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_NAME="AR Jishan Luxury Smart Bus Service"
NEXT_PUBLIC_CURRENCY="BDT"
NEXT_PUBLIC_TIMEZONE="Asia/Dhaka"

# bKash API Credentials (Tokenized Checkout)
BKASH_APP_KEY=sandbox_app_key
BKASH_APP_SECRET=sandbox_app_secret
BKASH_USERNAME=sandbox_username
BKASH_PASSWORD=sandbox_password
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

# Nagad API Credentials
NAGAD_MERCHANT_ID=sandbox_merchant_id
NAGAD_BASE_URL=http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0/api/dfs
NAGAD_PUBLIC_KEY=sandbox_public_key
NAGAD_PRIVATE_KEY=sandbox_private_key

# SMS Notification Gateway (Configurable)
SMS_PROVIDER=mock
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=ARJISHAN

# Mapbox / Google Maps (Optional for GPS Visualization)
NEXT_PUBLIC_MAP_PROVIDER=osm
NEXT_PUBLIC_MAPBOX_TOKEN=
